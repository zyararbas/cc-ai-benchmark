# Copy to config/local.env (gitignored) and source it before a run:
#   source config/local.env
#
# This repo is public, so the project id lives here rather than in
# config/models.json, which carries only the variable name.

export GOOGLE_CLOUD_PROJECT=your-gcp-project-id
export GOOGLE_CLOUD_LOCATION=global

# Only needed for the AI Studio backend instead of Vertex:
# export GEMINI_API_KEY=...
# export ANTHROPIC_API_KEY=...
# export OPENAI_API_KEY=...
